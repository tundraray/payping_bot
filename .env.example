# =============================================================================
# PayPing Bot Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# =============================================================================
# TronGrid API Configuration
# =============================================================================
# TronGrid API base URL (default: https://api.trongrid.io)
TRONGRID_BASE_URL=https://api.trongrid.io

# TronGrid API key (get one at https://www.trongrid.io/)
# Required for production usage to avoid rate limiting
TRONGRID_API_KEY=

# HTTP request timeout in milliseconds (default: 10000)
TRONGRID_TIMEOUT_MS=10000

# =============================================================================
# Polling Configuration
# =============================================================================
# Polling interval in milliseconds (default: 5000 = 5 seconds)
POLLING_INTERVAL_MS=5000

# Enable/disable polling on startup (default: true)
POLLING_ENABLED=true

# Fallback window when no transactions in DB (default: 60000 = 1 minute)
# Used only on first start when database has no transaction history
POLLING_FALLBACK_WINDOW_MS=60000

# =============================================================================
# LRU Cache Configuration (Transaction Deduplication)
# =============================================================================
# Maximum number of transaction hashes to keep in memory (default: 10000)
LRU_CACHE_SIZE=10000

# Time-to-live for cached entries in milliseconds (default: 3600000 = 1 hour)
LRU_CACHE_TTL_MS=3600000

# =============================================================================
# Retry/Backoff Configuration
# =============================================================================
# Initial backoff delay in milliseconds (default: 1000)
BACKOFF_INITIAL_MS=1000

# Maximum backoff delay in milliseconds (default: 60000)
BACKOFF_MAX_MS=60000

# Backoff multiplier (default: 2)
BACKOFF_MULTIPLIER=2

# Jitter range in milliseconds to prevent thundering herd (default: 500)
BACKOFF_JITTER_MS=500

# =============================================================================
# Contract Addresses
# =============================================================================
# USDT TRC20 contract address on TRON mainnet
# Default is the official Tether USDT contract
USDT_CONTRACT_ADDRESS=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# =============================================================================
# Database Configuration (PostgreSQL with Drizzle ORM)
# =============================================================================
# PostgreSQL connection URL (required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/payping_bot

# Connection pool maximum size (default: 10)
DB_POOL_MAX=10

# Idle connection timeout in milliseconds (default: 30000 = 30 seconds)
DB_POOL_IDLE_TIMEOUT_MS=30000

# Connection acquisition timeout in milliseconds (default: 10000 = 10 seconds)
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Run migrations on startup (default: true)
# Set to 'false' to disable automatic migrations
DB_RUN_MIGRATIONS=true

# =============================================================================
# Wallet Configuration
# =============================================================================
# TRON wallet address to monitor for incoming transactions (required)
MONITORED_WALLET_ADDRESS=

# =============================================================================
# Telegram Bot Configuration
# =============================================================================
# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Admin user ID for error notifications (optional)
TELEGRAM_ADMIN_ID=
