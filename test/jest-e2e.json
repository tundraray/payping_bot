{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@app/blockchain(|/.*)$": "<rootDir>/../libs/blockchain/src/$1",
    "^@app/db(|/.*)$": "<rootDir>/../libs/db/src/$1",
    "^@app/telegram(|/.*)$": "<rootDir>/../libs/telegram/src/$1"
  }
}
